    {
      "name": "3. Фильтрация, поиск, статистика",
      "item": [
        {
          "name": "GET /products — категория и сортировка по цене",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?category=food&search={{runId}}&sort=price&order=asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const skus = pm.response.json().data.map((p) => p.sku.split('-')[0]);",
                  "pm.test('только продукты, по возрастанию цены', () => pm.expect(skus).to.eql(['KEFIR', 'MILK']));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products — диапазон цены",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?minPrice=1&maxPrice=100&search={{runId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const prices = pm.response.json().data.map((p) => p.price);",
                  "pm.test('все цены от 1 до 100', () => prices.forEach((x) => pm.expect(x).to.be.within(1, 100)));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products — поиск по названию",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?search=дрель"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('найдена дрель', () => pm.expect(pm.response.json().data.map((p) => p.category)).to.include('building'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products — только неактивные",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?isActive=false&search={{runId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('одно мыло', () => pm.expect(pm.response.json().data.map((p) => p.sku.split('-')[0])).to.eql(['SOAP']));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/stats — статистика",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/stats",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('итоги и категории', () => {",
                  "  pm.expect(body).to.include.keys('total', 'active', 'inactive', 'avgPrice', 'byCategory');",
                  "  pm.expect(body.byCategory.map((c) => c.category)).to.include.members(['food', 'household', 'building']);",
                  "});"
                ]
              }
            }
          ]
        }
