{
  "info": {
    "name": "WMS API — контрольная работа 1",
    "description": "CRUD товаров склада с JWT-аутентификацией и ролями. Папки выполняются по порядку: токены и id передаются через переменные коллекции. Артикулы и email содержат runId, поэтому коллекцию можно запускать повторно без сброса базы. Учётная запись администратора задаётся переменными adminEmail и adminPassword (как ADMIN_EMAIL и ADMIN_PASSWORD в .env).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin123!"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "authorToken",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Аутентификация",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('runId', Date.now().toString(36).toUpperCase());"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация — успех",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"author.{{runId}}@example.com\",\n  \"password\": \"Password1!\",\n  \"name\": \"Кладовщик Иванова\",\n  \"role\": \"admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('роль user, хеша нет', () => {",
                  "  pm.expect(body.data.role).to.eql('user');",
                  "  pm.expect(body.data.passwordHash).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация — email уже занят",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"author.{{runId}}@example.com\",\n  \"password\": \"Password1!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('сообщение', () => pm.expect(pm.response.json().error.message).to.eql('Пользователь с таким email уже существует'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация — ошибки валидации",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "const fields = pm.response.json().error.details.map((d) => d.field);",
                  "pm.test('ошибки email и password', () => pm.expect(fields).to.include.members(['email', 'password']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация второго кладовщика",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"other.{{runId}}@example.com\",\n  \"password\": \"Password1!\",\n  \"name\": \"Кладовщик Петров\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Логин — получение JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"author.{{runId}}@example.com\",\n  \"password\": \"Password1!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('есть accessToken', () => pm.expect(body.data.accessToken).to.match(/^eyJ/));",
                  "pm.collectionVariables.set('authorToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Логин — неверный пароль",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"author.{{runId}}@example.com\",\n  \"password\": \"Wrong-pass1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Логин второго кладовщика",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"other.{{runId}}@example.com\",\n  \"password\": \"Password1!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('otherToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Логин администратора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('роль admin', () => pm.expect(pm.response.json().data.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me — профиль по токену",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('тот же пользователь', () => pm.expect(pm.response.json().data.email).to.include('author.'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Товары — CRUD",
      "item": [
        {
          "name": "POST /products — создать товар",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"MILK-{{runId}}\",\n  \"name\": \"Молоко 3,2% 1 л\",\n  \"category\": \"food\",\n  \"unit\": \"l\",\n  \"price\": 2.49,\n  \"weightKg\": 1.03,\n  \"description\": \"Пастеризованное, тетрапак\",\n  \"role\": \"admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('поля сохранены', () => {",
                  "  pm.expect(body.data.category).to.eql('food');",
                  "  pm.expect(body.data.price).to.eql(2.49);",
                  "});",
                  "pm.collectionVariables.set('productId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /products — кефир",
          "request": {
            "method": "POST",
