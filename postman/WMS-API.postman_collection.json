  "item": [
    {
      "name": "Служебное",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Frame-Options DENY', () => pm.response.to.have.header('X-Frame-Options', 'DENY'));",
                  "pm.test('CSP', () => pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"frame-ancestors\"));"
                ]
              }
            }
          ]
        }
      ]
    },
