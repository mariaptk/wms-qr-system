                  "const body = pm.response.json();",
                  "pm.test('роль user, несмотря на role=admin в теле', () => pm.expect(body.data.role).to.eql('user'));",
                  "pm.test('хеш пароля не вернулся', () => pm.expect(body.data.passwordHash).to.be.undefined);",
                  "pm.collectionVariables.set('userId', body.data.id);"
