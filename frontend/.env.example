# Адрес бэкенда. Локально — http://localhost:3000, в Vercel — URL сервиса на Render
VITE_API_URL=http://localhost:3000

# DSN проекта Sentry для React (Settings → Client Keys). Пусто — Sentry выключен
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Только для загрузки source maps в Sentry при сборке (в CI, не в браузере)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
