PORT=3000
NODE_ENV=development

# PostgreSQL. Для Neon добавьте ?sslmode=require и DATABASE_SSL=true
DATABASE_URL=postgres://wms:wms@127.0.0.1:5432/wms
TEST_DATABASE_URL=postgres://wms:wms@127.0.0.1:5432/wms_test
DATABASE_SSL=false

# Два разных секрета длиной не меньше 32 символов
JWT_SECRET=replace-with-a-long-random-access-secret-32b
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32
JWT_ACCESS_TTL=15m

# Белый список источников фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX=60
MAX_SESSIONS=3
BCRYPT_ROUNDS=12

# Учётная запись администратора для npm run seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Администратор

# Включить за reverse-proxy (Render, Railway) в лабораторной 2
TRUST_PROXY=false
