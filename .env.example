PORT=3000
NODE_ENV=development

# PostgreSQL. Для Neon: строка подключения из Connection Details (с ?sslmode=require) и DATABASE_SSL=true
DATABASE_URL=postgres://wms:wms@127.0.0.1:5432/wms
TEST_DATABASE_URL=postgres://wms:wms@127.0.0.1:5432/wms_test
DATABASE_SSL=false

# Два разных секрета длиной не меньше 32 символов
JWT_SECRET=replace-with-a-long-random-access-secret-32b
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32
JWT_ACCESS_TTL=15m

# Белый список источников фронтенда (через запятую). В production — адрес сайта на Vercel
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# strict — фронтенд и API на одном сайте; none — фронтенд на Vercel, API на Render (cookie станет Secure)
COOKIE_SAMESITE=strict

BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX=60
MAX_SESSIONS=3
BCRYPT_ROUNDS=12

# Учётная запись администратора для npm run seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Администратор
# Пароль демо-сотрудников для npm run seed:demo
DEMO_PASSWORD=Sklad2026!

# За reverse-proxy (Render) — true, чтобы rate limit видел настоящий IP клиента
TRUST_PROXY=false

# --- Мониторинг (ИПР2). Пустое значение — интеграция выключена ---
# Sentry: Project Settings → Client Keys (DSN). Подходит и DSN GlitchTip
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Better Stack Logs (бывший Logtail): Sources → ваш источник → Source token и Ingesting host
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=

# Telegram: токен от @BotFather и chat_id получателя
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_INTERVAL_MS=60000
